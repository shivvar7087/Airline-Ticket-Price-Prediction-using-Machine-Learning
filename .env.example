# ==========================================
# Airline Ticket Price Prediction - Environment Config Template
# Copy this file to .env and configure values as needed:
# cp .env.example .env
# ==========================================

# Application Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Model & Artifact Storage Paths
MODEL_PATH=models/flight_price_model.joblib
METRICS_PATH=models/metrics.json
METADATA_PATH=models/feature_metadata.json

# Dataset Path
DATASET_PATH=dataset/data.xlsx

# Security & CORS Settings
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

